#---------------------------------------------------------------------
#
# Dockerfile for the OpenAirInterface UDM service
#   Valid for CentOS Stream 10
#
#---------------------------------------------------------------------

#---------------------------------------------------------------------
# BUILDER IMAGE
#---------------------------------------------------------------------

FROM quay.io/centos/centos:stream10 AS oai-udm-builder

ENV IS_DOCKERFILE=1

# meson and ninja-build come from CRB; cryptopp-devel and libidn-devel come
# from EPEL. The other build_udm dependencies are in BaseOS/AppStream.
RUN dnf config-manager --set-enabled crb && \
    dnf install epel-release -y && \
    dnf update -y && \
    # Log the exact OS release used for the build.
    cat /etc/os-release && \
    dnf install -y \
        psmisc \
        git \
        diffutils \
        libasan \
        wget \
        file && \
    # Libraries built from source are installed under /usr/local, which is not
    # on the default loader path on EL. This is also needed for the ldd check.
    echo "/usr/local/lib" > /etc/ld.so.conf.d/local-lib.conf && \
    echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local-lib.conf

# Git configuration
RUN git config --global https.postBuffer 123289600 && \
    git config --global http.sslverify false

# Copy source code
WORKDIR /openair-udm
COPY . /openair-udm

# Install and Build UDM
WORKDIR /openair-udm/build/scripts
RUN ./build_udm --install-deps --force
RUN ./build_udm --clean --Verbose --build-type Release --jobs && \
    ldd /openair-udm/build/udm/build/udm && \
    mv /openair-udm/build/udm/build/udm /openair-udm/build/udm/build/oai_udm

FROM mikefarah/yq:latest AS yq-source

#---------------------------------------------------------------------
# TARGET IMAGE
#---------------------------------------------------------------------
FROM quay.io/centos/centos:stream10-minimal AS oai-udm
ENV TZ=Europe/Paris

RUN microdnf update -y && \
    microdnf install -y \
# Timezone data, and debugging/networking utilities
      tzdata \
      procps-ng \
      psmisc \
      net-tools \
      iputils \
      tcpdump \
# Runtime dependencies of oai_udm
      libicu \
      boost \
      libevent \
      nettle \
      gmp \
      findutils && \
    microdnf clean all -y && \
    rm -rf /var/cache/yum /var/cache/dnf

# Copy executable and generated libraries
WORKDIR /openair-udm/bin
COPY --from=oai-udm-builder \
    /openair-udm/build/udm/build/oai_udm \
    /openair-udm/scripts/healthcheck.sh \
    ./
COPY --from=yq-source /usr/bin/yq /usr/bin

# The libraries built from source, plus cryptopp, which lives in EPEL and so
# cannot be installed on the minimal image. pistache (meson) and nghttp2
# (autotools) install into lib, the CMake-built spdlog, fmt, yaml-cpp and cpr
# into lib64.
COPY --from=oai-udm-builder \
    /usr/local/lib/libpistache.so* \
    /usr/local/lib/libnghttp2_asio.so \
    /usr/local/lib/libnghttp2_asio.so.1 \
    /usr/local/lib64/libspdlog.so \
    /usr/local/lib64/libfmt.so \
    /usr/local/lib64/libyaml-cpp.so.0.* \
    /usr/local/lib64/libcpr.so.1* \
    /usr/lib64/libcryptopp.so.8 \
    /usr/lib64/

RUN ldconfig && \
    ldd /openair-udm/bin/oai_udm && \
    # ldd exits 0 even when a library is missing, so check its output
    ! ldd /openair-udm/bin/oai_udm | grep -q 'not found'

WORKDIR /openair-udm/etc
COPY --from=oai-udm-builder \
    /openair-udm/etc/config.yaml ./

WORKDIR /openair-udm

# Expose ports
EXPOSE 80/tcp

# Configure healthcheck
HEALTHCHECK --interval=10s \
            --timeout=15s \
            --retries=6 \
    CMD /openair-udm/bin/healthcheck.sh

CMD ["/openair-udm/bin/oai_udm", "-c" , "/openair-udm/etc/config.yaml", "-o"]
